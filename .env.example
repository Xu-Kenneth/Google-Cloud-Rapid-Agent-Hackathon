# ============================================================================
# Bull vs Bear — environment template
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# Gemini / Google GenAI  (REQUIRED — pick ONE option)
# ----------------------------------------------------------------------------
# Option A — Google AI Studio (simplest, free tier).
#   Set USE_VERTEXAI=false and paste an AI Studio key below.
#   Get one at: https://aistudio.google.com/app/apikey
#
# Option B — Vertex AI (Google Cloud).
#   Set USE_VERTEXAI=true, fill GOOGLE_CLOUD_PROJECT/LOCATION, then run:
#     gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=false

# Option A key (leave blank if using Vertex AI)
GOOGLE_API_KEY=

# Option B settings (leave blank if using AI Studio)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Model id (configurable)
GEMINI_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------------
# Market data  (OPTIONAL — yfinance fallback needs no key)
# ----------------------------------------------------------------------------
# Free Finnhub key for nicer quotes/news: https://finnhub.io/dashboard
# Leave blank to fall back to yfinance (no key required).
FINNHUB_API_KEY=

# ----------------------------------------------------------------------------
# Arize Phoenix  (observability — local OSS, NO key needed)
# ----------------------------------------------------------------------------
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=bull-vs-bear

# ----------------------------------------------------------------------------
# Persistence  (local | firestore)
# ----------------------------------------------------------------------------
# `local`  -> store debate history in a local file (no GCP needed)
# `firestore` -> use Firestore (requires GOOGLE_CLOUD_PROJECT + credentials)
HISTORY_BACKEND=local

# ----------------------------------------------------------------------------
# Backend server
# ----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated allowed origins for the frontend (CORS)
CORS_ALLOW_ORIGINS=http://localhost:5173
